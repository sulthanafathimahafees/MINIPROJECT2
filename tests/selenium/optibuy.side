{
  "id": "c1f7a83d-e421-4f1b-90df-a07e153b6e01",
  "version": "2.0",
  "name": "OptiBuy Decision Support Ecosystem",
  "url": "http://localhost:5173",
  "tests": [
    {
      "id": "e4b2d9a1-0f2c-47bc-8ef1-a7962c019d11",
      "name": "TC_SEL_01_Customer_Authentication",
      "commands": [
        {
          "id": "cmd-01-01",
          "comment": "Open Login Page",
          "command": "open",
          "target": "/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-01-02",
          "comment": "Set Browser Viewport Size",
          "command": "setWindowSize",
          "target": "1280x800",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-01-03",
          "comment": "Focus Customer Email Input",
          "command": "click",
          "target": "id=email-input",
          "targets": [
            ["id=email-input", "id"],
            ["css=#email-input", "css:finder"],
            ["xpath=//input[@id='email-input']", "xpath:attributes"]
          ],
          "value": ""
        },
        {
          "id": "cmd-01-04",
          "comment": "Type Verified Customer Email",
          "command": "type",
          "target": "id=email-input",
          "targets": [
            ["id=email-input", "id"],
            ["css=#email-input", "css:finder"]
          ],
          "value": "aryadileep@gmail.com"
        },
        {
          "id": "cmd-01-05",
          "comment": "Focus Customer Password Input",
          "command": "click",
          "target": "id=password-input",
          "targets": [
            ["id=password-input", "id"],
            ["css=#password-input", "css:finder"],
            ["xpath=//input[@id='password-input']", "xpath:attributes"]
          ],
          "value": ""
        },
        {
          "id": "cmd-01-06",
          "comment": "Type Verified Password",
          "command": "type",
          "target": "id=password-input",
          "targets": [
            ["id=password-input", "id"],
            ["css=#password-input", "css:finder"]
          ],
          "value": "password123"
        },
        {
          "id": "cmd-01-07",
          "comment": "Click Login Submit Button",
          "command": "click",
          "target": "id=login-submit-btn",
          "targets": [
            ["id=login-submit-btn", "id"],
            ["css=#login-submit-btn", "css:finder"],
            ["xpath=//button[@id='login-submit-btn']", "xpath:attributes"]
          ],
          "value": ""
        },
        {
          "id": "cmd-01-08",
          "comment": "Wait for Customer Dashboard Header",
          "command": "waitForElementPresent",
          "target": "id=dashboard-header",
          "targets": [
            ["id=dashboard-header", "id"],
            ["css=#dashboard-header", "css:finder"]
          ],
          "value": "5000"
        },
        {
          "id": "cmd-01-09",
          "comment": "Verify Welcome Message Contains Customer Name",
          "command": "assertText",
          "target": "id=dashboard-header",
          "targets": [
            ["id=dashboard-header", "id"]
          ],
          "value": "Welcome back, Arya Dileep!"
        }
      ]
    },
